{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mstor",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/dav/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mstor" }],
  "d1_databases": [{ "binding": "DB", "database_name": "mstor", "database_id": "7d08a95a-6f35-4e8a-850f-682ec77d4f84" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "OIDC_ISSUER": "https://auth.msxor.com",
    "OIDC_CLIENT_ID": "nXkJYhtDkyjGbNHayEOhmjqVfwTKvlEW",
    "PUBLIC_URL": "https://stor.msxor.com",
    "R2_ENDPOINT": "https://1c8085f64526758e5e231ee2f5395a2e.r2.cloudflarestorage.com/mstor",
    "DEFAULT_QUOTA_BYTES": "10737418240",
    "SMALL_FILE_LIMIT": "62914560",
    "TRASH_RETENTION_DAYS": "30"
  }
}
