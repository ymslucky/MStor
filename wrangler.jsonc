{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mstor",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  // 关闭 workers.dev 入口：认证由 Cloudflare Access 在边缘接管，避免出现绕过 Access 的直连域名
  "workers_dev": false,
  "routes": [{ "pattern": "stor.msxor.com", "custom_domain": true }],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mstor" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "mstor", "database_id": "7d08a95a-6f35-4e8a-850f-682ec77d4f84" },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    // —— Cloudflare Access 认证（上线前替换为 Zero Trust 控制台的实际值）——
    "ACCESS_TEAM_DOMAIN": "https://ymslucky.cloudflareaccess.com",
    "ACCESS_AUD": "572d0b7681bd7e98cd0bf698df79b586a3d48fbef9bb7e65e4c99a6656fac51b",
    "AUTH_MODE": "access",
    "ACCESS_PROVISION": "off",
    "PUBLIC_URL": "https://stor.msxor.com",
    "R2_ENDPOINT": "https://1c8085f64526758e5e231ee2f5395a2e.r2.cloudflarestorage.com/mstor",
    "DEFAULT_QUOTA_BYTES": "10737418240",
    "SMALL_FILE_LIMIT": "62914560",
    "TRASH_RETENTION_DAYS": "30",
  },
}
