{
  "name": "mstor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "predeploy": "node scripts/verify-access-config.mjs",
    "deploy": "vite build && wrangler deploy",
    "test": "npm run test:client && npm run test:server",
    "test:server": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server:local": "node scripts/test-server.cjs",
    "test:ci": "npm run test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:server && npm run check:client && npm run check:schema && npm run lint",
    "check:server": "tsc --noEmit",
    "check:client": "tsc -p client --noEmit",
    "check:schema": "node scripts/validate-schema-v2.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "aws4fetch": "^1.0.20",
    "hash-wasm": "^4.12.0",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20260625.1",
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "wrangler": "4.105.0"
  }
}
