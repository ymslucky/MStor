{
  "name": "mstor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "npm run test:client && npm run test:server",
    "test:server": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:watch": "vitest",
    "check": "npm run check:server && npm run check:client",
    "check:server": "tsc --noEmit",
    "check:client": "tsc -p client --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
